# npm registry configuration for @llipe.com/dev-tasks
# Auth is handled by:
#   - CI: NODE_AUTH_TOKEN set by setup-node action (no .npmrc token needed)
#   - Local: `npm login` writes credentials to ~/.npmrc
#
# We intentionally do NOT set _authToken here to avoid overriding
# the user-level ~/.npmrc credentials during local development.
registry=https://registry.npmjs.org/
