#!/usr/bin/env node
// Fake `gh` for the Layer 2 CLI tests (test plan A-85). Hand-written; not
// generated from the code under test.
//
// FAKE_GH_SCENARIO: path to a JSON file `{ "responses": { "<argv joined by
//   U+0001>": { "stdout", "stderr", "exitCode" } } }`.
// FAKE_GH_LOG: path to a file that receives one JSON argv array per line.
//
// An argv with no scenario entry exits 1 with `fake gh: unhandled argv`, so
// a read the test did not expect cannot pass silently.
import { appendFileSync, readFileSync } from "node:fs";

const argv = process.argv.slice(2);
if (process.env.FAKE_GH_LOG) appendFileSync(process.env.FAKE_GH_LOG, JSON.stringify(argv) + "\n");
const scenario = JSON.parse(readFileSync(process.env.FAKE_GH_SCENARIO, "utf-8"));
const hit = scenario.responses[argv.join("\u0001")];
if (!hit) {
  process.stderr.write(`fake gh: unhandled argv: ${argv.join(" ")}\n`);
  process.exit(1);
}
process.stdout.write(hit.stdout);
process.stderr.write(hit.stderr);
process.exit(hit.exitCode);
