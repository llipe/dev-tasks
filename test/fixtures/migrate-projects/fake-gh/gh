#!/usr/bin/env node
// Fake `gh` for the Layer 2 CLI tests (test plan A-85). Hand-written; not
// generated from the code under test.
//
// FAKE_GH_SCENARIO: path to a JSON file `{ "responses": { "<argv joined by
//   U+0001>": { "stdout", "stderr", "exitCode", "delayMs"? } } }`. A body
//   file path (`--body-file=<p>`, `--field=body=@<p>`) is keyed as `<file>`,
//   since `--apply` writes it under a fresh temp name each run (S-015).
// FAKE_GH_LOG: path to a file that receives one JSON argv array per line.
// FAKE_GH_BODIES: optional path to a file that receives one JSON
//   `{ argv, body }` per call that names a body file, read at call time.
// FAKE_GH_DELAY_MS: optional delay before every answer, so a test can
//   interrupt a run between calls.
// FAKE_GH_LANDED: optional path to a file that receives one JSON argv per
//   call that got past its delay: a write that "landed". A fake killed
//   during its delay never reaches it.
//
// An argv with no scenario entry exits 1 with `fake gh: unhandled argv`, so
// a read the test did not expect cannot pass silently.
import { appendFileSync, existsSync, readFileSync } from "node:fs";

const argv = process.argv.slice(2);
if (process.env.FAKE_GH_LOG) appendFileSync(process.env.FAKE_GH_LOG, JSON.stringify(argv) + "\n");
const bodyPath = (a) => (a.match(/^--body-file=(.+)$/) ?? a.match(/^--field=body=@(.+)$/))?.[1];
for (const a of argv) {
  const p = bodyPath(a);
  if (p !== undefined && process.env.FAKE_GH_BODIES) {
    const body = existsSync(p) ? readFileSync(p, "utf-8") : null;
    appendFileSync(process.env.FAKE_GH_BODIES, JSON.stringify({ argv, body }) + "\n");
  }
}
const key = argv
  .map((a) =>
    a.replace(/^--body-file=.+$/, "--body-file=<file>").replace(/^--field=body=@.+$/, "--field=body=@<file>"),
  )
  .join("\u0001");
const scenario = JSON.parse(readFileSync(process.env.FAKE_GH_SCENARIO, "utf-8"));
const hit = scenario.responses[key];
const delay = Number(hit?.delayMs ?? process.env.FAKE_GH_DELAY_MS ?? 0);
if (delay > 0) Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, delay);
if (!hit) {
  process.stderr.write(`fake gh: unhandled argv: ${argv.join(" ")}\n`);
  process.exit(1);
}
// The answer is about to be given: for a write, the moment it lands.
if (process.env.FAKE_GH_LANDED) appendFileSync(process.env.FAKE_GH_LANDED, JSON.stringify(argv) + "\n");
process.stdout.write(hit.stdout);
process.stderr.write(hit.stderr);
process.exit(hit.exitCode);
