{
  "version": "v1",
  "hooks": [
    {
      "name": "git-guard",
      "trigger": "PreToolUse",
      "matcher": "execute_bash|shell|runCommand",
      "action": {
        "type": "command",
        "command": ".kiro/hooks/scripts/git-guard.sh"
      },
      "timeout": 10,
      "enabled": true
    },
    {
      "name": "branch-guard",
      "trigger": "PreToolUse",
      "matcher": "fs_write|str_replace|fs_append",
      "action": {
        "type": "command",
        "command": ".kiro/hooks/scripts/branch-guard.sh"
      },
      "timeout": 5,
      "enabled": true
    }
  ]
}
