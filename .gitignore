# Ignore node_modules and Python environments
node_modules/
.env
venv/
__pycache__/

# TypeScript build output
dist/

# pnpm
pnpm-debug.log*

# Ignore system files
.DS_Store
Thumbs.db

# Ignore editor/project files
.vscode/
.idea/
*.swp

# Ignore generated workstream docs and tasks (if not tracked)
# Keep foundational docs and requirements tracked
/workstream/*.md
/docs/*.md
!/docs/README.md
!/docs/product-context.md
!/docs/technical-guidelines.md
!/docs/system-overview.md
!/docs/data-model.md
!/docs/workflow-chains.md
!/docs/agents-md-guidelines.md
!/docs/artifact-formats.md
!/docs/dt-user-manual.md
!/docs/dev-tasks-user-manual.md
!/docs/adr/
!/docs/requirements/

# Test fixture generated outputs (created by catalog build tests)
test/fixtures/catalog/catalog/components/
test/fixtures/catalog/catalog/index.yaml

# Ignore log files
*.log

# Ignore backup files
*~
*.bak

# Ignore OS trash
.Trashes


# Manual test scratch file
test/_manual.ts
