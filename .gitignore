# Ignore node_modules and Python environments
node_modules/
.env
venv/
__pycache__/

# TypeScript build output
dist/

# pnpm
pnpm-debug.log*

# Ignore system files
.DS_Store
Thumbs.db

# Ignore editor/project files
.vscode/
.idea/
*.swp

# Active workstream artifacts are per-feature scratch; archived copies are durable.
/workstream/*.md

# /docs is deliberately NOT ignored. It previously used `/docs/*.md` plus one
# negation per file, which silently swallowed any document nobody remembered to
# allowlist — and rotted twice over: three negations outlived the files Phase 0
# deleted, and the Phase 1 rename would have landed on two ignored filenames.
# Nothing generates throwaway markdown into /docs, so an allowlist buys nothing.
# Ignore a specific generated file here if one ever appears.

# Test fixture generated outputs (created by catalog build tests)
test/fixtures/catalog/catalog/components/
test/fixtures/catalog/catalog/index.yaml

# Ignore log files
*.log

# Ignore backup files
*~
*.bak

# Ignore OS trash
.Trashes


# Manual test scratch file
test/_manual.ts


# Generated mockup apps — source tracked, build output ignored
/mockups/*/node_modules/
/mockups/*/dist/
/mockups/*/.vite/

# Active workstream mockups are transient; archived copies are durable
/workstream/mockups/
