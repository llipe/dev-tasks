{
  "name": "@llipe.com/dev-tasks",
  "version": "0.9.0",
  "description": "Multi-repo context tooling for dev-tasks",
  "type": "module",
  "imports": {
    "#core/*": "./dist/core/*",
    "#adapters/*": "./dist/adapters/*"
  },
  "bin": {
    "dev-tasks": "dist/bin/dev-tasks.js",
    "dt": "dist/bin/dt.js"
  },
  "files": [
    "dist/bin/",
    "dist/core/",
    "dist/adapters/",
    "schemas/",
    ".github/agents/",
    ".github/skills/",
    ".github/instructions/",
    ".github/prompts/",
    ".claude/agents/",
    ".claude/skills/",
    ".claude/commands/",
    ".claude/hooks/",
    ".kiro/agents/",
    ".kiro/skills/",
    ".kiro/steering/",
    ".kiro/hooks/",
    "AGENTS.md",
    "CLAUDE.md",
    "bundle-manifest.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run validate && pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"bin/\" \"core/\" \"adapters/\" \"schemas/\" \"test/\" \"*.json\" \"*.ts\" \"eslint.config.js\" --ignore-unknown",
    "format:check": "prettier --check \"bin/\" \"core/\" \"adapters/\" \"schemas/\" \"test/\" \"*.json\" \"*.ts\" \"eslint.config.js\" --ignore-unknown",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "audit": "pnpm audit --prod",
    "validate": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test"
  },
  "keywords": [
    "dev-tasks",
    "ai-agents",
    "multi-repo",
    "context",
    "extraction",
    "openapi",
    "asyncapi",
    "schema"
  ],
  "author": "llipe",
  "repository": {
    "type": "git",
    "url": "https://github.com/llipe/dev-tasks.git"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "22.15.18",
    "@typescript-eslint/eslint-plugin": "8.32.1",
    "@typescript-eslint/parser": "8.32.1",
    "eslint": "9.27.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-import-x": "4.12.2",
    "express": "^5.2.1",
    "globals": "16.1.0",
    "prettier": "3.5.3",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.1",
    "vitest": "3.2.6"
  },
  "dependencies": {
    "ajv": "8.18.0",
    "execa": "9.5.2",
    "yaml": "2.8.3"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0",
    "pg": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.5",
      "brace-expansion@>=2.0.0 <2.1.4": ">=2.1.4",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "brace-expansion@<1.1.18": ">=1.1.18"
    }
  }
}
