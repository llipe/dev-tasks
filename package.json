{
  "name": "@llipe.com/dev-tasks",
  "version": "0.16.1",
  "description": "AI agent toolkit for structured, PRD-driven development workflows",
  "type": "module",
  "imports": {
    "#core/*": "./dist/core/*"
  },
  "bin": {
    "dev-tasks": "dist/bin/dev-tasks.js"
  },
  "files": [
    "dist/bin/",
    "dist/core/",
    ".github/agents/",
    ".github/skills/",
    ".github/instructions/",
    ".github/prompts/",
    ".claude/agents/",
    ".claude/skills/",
    ".claude/commands/",
    ".claude/hooks/",
    ".kiro/agents/",
    ".kiro/skills/",
    ".kiro/steering/",
    ".kiro/hooks/",
    "templates/",
    "AGENTS.md",
    "CLAUDE.md",
    "AGENTS.md.template",
    "CLAUDE.md.template",
    "DESIGN.md",
    "TESTING.md",
    "bundle-manifest.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run validate && pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && tsx core/checks/run.ts",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"bin/\" \"core/\" \"test/\" \"*.json\" \"*.ts\" \"eslint.config.js\" --ignore-unknown",
    "format:check": "prettier --check \"bin/\" \"core/\" \"test/\" \"*.json\" \"*.ts\" \"eslint.config.js\" --ignore-unknown",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "audit": "pnpm audit --prod",
    "validate": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test"
  },
  "keywords": [
    "dev-tasks",
    "ai-agents",
    "workflow",
    "prd",
    "claude-code"
  ],
  "author": "llipe",
  "repository": {
    "type": "git",
    "url": "https://github.com/llipe/dev-tasks.git"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.32.1",
    "@typescript-eslint/parser": "8.32.1",
    "eslint": "9.27.0",
    "eslint-config-prettier": "10.1.5",
    "globals": "16.1.0",
    "prettier": "3.5.3",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.1",
    "vitest": "3.2.6",
    "yaml": "2.8.3"
  },
  "dependencies": {
    "execa": "9.5.2"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=2.0.0 <2.1.4": ">=2.1.4",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "brace-expansion@<1.1.18": ">=1.1.18"
    }
  }
}
